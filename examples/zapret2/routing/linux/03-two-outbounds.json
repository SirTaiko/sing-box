{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-direct",
        "server": "8.8.8.8"
      }
    ],
    "final": "dns-direct",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "direct",
      "tag": "zapret-a",
      "bind_interface": "eth0",
      "zapret": {
        "profile": "../../profiles/profile-linux.json"
      }
    },
    {
      "type": "direct",
      "tag": "zapret-b",
      "bind_interface": "eth0",
      "zapret": {
        "profile": "../../profiles/profile-linux.json"
      }
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "protocol": "dns",
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "rule_set": "geoip-ru",
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "youtube.com",
          "youtu.be",
          "googlevideo.com",
          "ytimg.com",
          "youtubei.googleapis.com"
        ],
        "outbound": "zapret-a"
      },
      {
        "domain_suffix": [
          "discord.com",
          "discord.gg",
          "discordapp.com",
          "discordapp.net",
          "discord.media"
        ],
        "outbound": "zapret-b"
      }
    ],
    "rule_set": [
      {
        "tag": "geoip-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-ru.srs"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "dns-direct"
  }
}
