+
+// peekSOCKS4DestinationFamily observes the fixed SOCKS4 request header
+// (CMD, PORT, DSTIP) without consuming it. The 0.0.0.x marker with a non-zero
+// x selects the SOCKS4a hostname form; this is a classification of the
+// original request form, not an invented byte from the request.
+func peekSOCKS4DestinationFamily(reader *std_bufio.Reader) (M.Family, bool) {
+	header, err := reader.Peek(7)
+	if err != nil {
+		return M.AddressFamilyEmpty, false
+	}
+	if header[3] == 0 && header[4] == 0 && header[5] == 0 && header[6] != 0 {
+		return M.AddressFamilyFqdn, true
+	}
+	return M.AddressFamilyIPv4, true
+}
+
+// peekSOCKS5DestinationFamily observes VER/CMD/RSV/ATYP of the CONNECT request
+// without consuming it. It runs only after the method and authentication
+// exchange has succeeded, so credential bytes are never interpreted here.
+func peekSOCKS5DestinationFamily(reader *std_bufio.Reader) (M.Family, bool) {
+	header, err := reader.Peek(4)
+	if err != nil {
+		return M.AddressFamilyEmpty, false
+	}
+	switch header[3] {
+	case M.AddressFamilyIPv4:
+		return M.AddressFamilyIPv4, true
+	case M.AddressFamilyIPv6:
+		return M.AddressFamilyIPv6, true
+	case M.AddressFamilyFqdn:
+		return M.AddressFamilyFqdn, true
+	default:
+		return M.AddressFamilyEmpty, false
+	}
+}
+
+// newRequestConn transfers exactly the bytes already buffered by the shared
+// handshake reader into one owned buffer and composes the existing cached
+// connection under the accepted connection. It performs no additional socket
+// read, does not wait for further early payload and destroys no parser state.
+func newRequestConn(conn net.Conn, reader *std_bufio.Reader) (net.Conn, error) {
+	buffered := reader.Buffered()
+	if buffered == 0 {
+		return conn, nil
+	}
+	buffer := buf.NewSize(buffered)
+	n, err := buffer.ReadFullFrom(reader, buffered)
+	if err != nil {
+		buffer.Release()
+		return nil, E.Cause(err, "socks: transfer buffered request payload")
+	}
+	if n != buffered {
+		buffer.Release()
+		return nil, E.New("socks: transfer buffered request payload: short read")
+	}
+	return bufio.NewCachedConn(conn, buffer), nil
+}
+
+func newRequestLazyConn(conn net.Conn, version byte, destinationFamily M.Family, metadataKnown bool) *LazyConn {
+	if !metadataKnown {
+		return NewLazyConn(conn, version)
+	}
+	return newLazyConnWithRequestMetadata(conn, version, RequestMetadata{
+		Version:           version,
+		DestinationFamily: destinationFamily,
+	})
+}
