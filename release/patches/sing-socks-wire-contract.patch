+package socks
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/auth"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type capturedConnection struct {
+	conn        net.Conn
+	source      M.Socksaddr
+	destination M.Socksaddr
+	onClose     N.CloseHandlerFunc
+}
+
+type captureHandler struct {
+	connections chan capturedConnection
+	packets     chan struct{}
+}
+
+func newCaptureHandler() *captureHandler {
+	return &captureHandler{
+		connections: make(chan capturedConnection, 4),
+		packets:     make(chan struct{}, 4),
+	}
+}
+
+func (h *captureHandler) NewConnectionEx(ctx context.Context, conn net.Conn, source M.Socksaddr, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	h.connections <- capturedConnection{conn: conn, source: source, destination: destination, onClose: onClose}
+}
+
+func (h *captureHandler) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, source M.Socksaddr, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	h.packets <- struct{}{}
+}
+
+func (h *captureHandler) wait(t *testing.T) capturedConnection {
+	t.Helper()
+	select {
+	case connection := <-h.connections:
+		return connection
+	case <-time.After(5 * time.Second):
+		t.Fatal("connection was not dispatched")
+		return capturedConnection{}
+	}
+}
+
+func (h *captureHandler) expectNoConnection(t *testing.T) {
+	t.Helper()
+	select {
+	case connection := <-h.connections:
+		t.Fatalf("unexpected connection dispatch: %+v", connection.destination)
+	case <-time.After(100 * time.Millisecond):
+	}
+}
+
+// addressConn gives the memory pipe a TCP-like local address so the shared
+// SOCKS4 response writer produces its ordinary eight-byte bind frame.
+type addressConn struct {
+	net.Conn
+}
+
+func (c *addressConn) LocalAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4(192, 0, 2, 1), Port: 1080}
+}
+
+// startHandshake starts the real shared handshake on a memory pipe and returns
+// the client side.
+func startHandshake(t *testing.T, authenticator *auth.Authenticator) (net.Conn, *captureHandler) {
+	t.Helper()
+	clientConn, serverConn := net.Pipe()
+	handler := newCaptureHandler()
+	wrappedConn := &addressConn{Conn: serverConn}
+	go func() {
+		_ = HandleConnectionEx(
+			context.Background(), wrappedConn, bufio.NewReader(wrappedConn),
+			authenticator, handler, nil, 0,
+			M.ParseSocksaddr("127.0.0.1:1234"), nil,
+		)
+	}()
+	t.Cleanup(func() {
+		_ = clientConn.Close()
+		_ = serverConn.Close()
+	})
+	return clientConn, handler
+}
+
+func writeAll(t *testing.T, conn net.Conn, payload []byte) {
+	t.Helper()
+	if _, err := conn.Write(payload); err != nil {
+		t.Fatalf("write handshake: %v", err)
+	}
+}
+
+func readN(t *testing.T, conn net.Conn, length int) []byte {
+	t.Helper()
+	buffer := make([]byte, length)
+	if _, err := io.ReadFull(conn, buffer); err != nil {
+		t.Fatalf("read %d bytes: %v", length, err)
+	}
+	return buffer
+}
+
+func negotiateSOCKS5(t *testing.T, conn net.Conn) {
+	t.Helper()
+	writeAll(t, conn, []byte{0x05, 0x01, 0x00})
+	if reply := readN(t, conn, 2); !bytes.Equal(reply, []byte{0x05, 0x00}) {
+		t.Fatalf("unexpected method selection: %x", reply)
+	}
+}
+
+func request5ATYP1(addr netip.Addr, port uint16) []byte {
+	ip := addr.As4()
+	return []byte{0x05, 0x01, 0x00, 0x01, ip[0], ip[1], ip[2], ip[3], byte(port >> 8), byte(port)}
+}
+
+func request5ATYP6(addr netip.Addr, port uint16) []byte {
+	ip := addr.As16()
+	request := []byte{0x05, 0x01, 0x00, 0x04}
+	request = append(request, ip[:]...)
+	return append(request, byte(port>>8), byte(port))
+}
+
+func request5ATYP3(domain string, port uint16) []byte {
+	request := []byte{0x05, 0x01, 0x00, 0x03, byte(len(domain))}
+	request = append(request, domain...)
+	return append(request, byte(port>>8), byte(port))
+}
+
+func request4(addr netip.Addr, port uint16) []byte {
+	ip := addr.As4()
+	return []byte{0x04, 0x01, byte(port >> 8), byte(port), ip[0], ip[1], ip[2], ip[3], 0x00}
+}
+
+func request4a(domain string, port uint16) []byte {
+	request := []byte{0x04, 0x01, byte(port >> 8), byte(port), 0x00, 0x00, 0x00, 0x01, 0x00}
+	request = append(request, domain...)
+	return append(request, 0x00)
+}
+
+func requestMetadataOf(t *testing.T, conn net.Conn) RequestMetadata {
+	t.Helper()
+	provider, loaded := conn.(RequestMetadataProvider)
+	if !loaded {
+		t.Fatalf("dispatched connection %T does not implement RequestMetadataProvider", conn)
+	}
+	requestMetadata, known := provider.RequestMetadata()
+	if !known {
+		t.Fatal("dispatched connection carries no request provenance")
+	}
+	return requestMetadata
+}
+
+func TestHandleConnectionExCapturesOriginalDestinationFamily(t *testing.T) {
+	fixtures := []struct {
+		name    string
+		request func(t *testing.T, conn net.Conn)
+		family  M.Family
+		version byte
+	}{
+		{
+			name: "socks5-atyp-ipv4",
+			request: func(t *testing.T, conn net.Conn) {
+				negotiateSOCKS5(t, conn)
+				writeAll(t, conn, request5ATYP1(netip.MustParseAddr("203.0.113.9"), 443))
+			},
+			family: M.AddressFamilyIPv4, version: 5,
+		},
+		{
+			name: "socks5-atyp-ipv6",
+			request: func(t *testing.T, conn net.Conn) {
+				negotiateSOCKS5(t, conn)
+				writeAll(t, conn, request5ATYP6(netip.MustParseAddr("2001:db8::9"), 443))
+			},
+			family: M.AddressFamilyIPv6, version: 5,
+		},
+		{
+			name: "socks5-atyp-domain",
+			request: func(t *testing.T, conn net.Conn) {
+				negotiateSOCKS5(t, conn)
+				writeAll(t, conn, request5ATYP3("example.com", 443))
+			},
+			family: M.AddressFamilyFqdn, version: 5,
+		},
+		{
+			name: "socks5-atyp-domain-numeric-ipv4",
+			request: func(t *testing.T, conn net.Conn) {
+				negotiateSOCKS5(t, conn)
+				writeAll(t, conn, request5ATYP3("192.0.2.9", 443))
+			},
+			family: M.AddressFamilyFqdn, version: 5,
+		},
+		{
+			name: "socks5-atyp-domain-numeric-ipv6",
+			request: func(t *testing.T, conn net.Conn) {
+				negotiateSOCKS5(t, conn)
+				writeAll(t, conn, request5ATYP3("2001:db8::9", 443))
+			},
+			family: M.AddressFamilyFqdn, version: 5,
+		},
+		{
+			name: "socks5-atyp-domain-numeric-ipv4-mapped",
+			request: func(t *testing.T, conn net.Conn) {
+				negotiateSOCKS5(t, conn)
+				writeAll(t, conn, request5ATYP3("::ffff:192.0.2.9", 443))
+			},
+			family: M.AddressFamilyFqdn, version: 5,
+		},
+		{
+			name: "socks4-literal",
+			request: func(t *testing.T, conn net.Conn) {
+				writeAll(t, conn, request4(netip.MustParseAddr("192.0.2.9"), 443))
+			},
+			family: M.AddressFamilyIPv4, version: 4,
+		},
+		{
+			name: "socks4a-hostname",
+			request: func(t *testing.T, conn net.Conn) {
+				writeAll(t, conn, request4a("example.com", 443))
+			},
+			family: M.AddressFamilyFqdn, version: 4,
+		},
+		{
+			name: "socks4a-numeric-hostname",
+			request: func(t *testing.T, conn net.Conn) {
+				writeAll(t, conn, request4a("192.0.2.9", 443))
+			},
+			family: M.AddressFamilyFqdn, version: 4,
+		},
+		{
+			name: "socks4a-non-one-marker",
+			request: func(t *testing.T, conn net.Conn) {
+				request := request4a("marker.example", 443)
+				request[7] = 0x02
+				writeAll(t, conn, request)
+			},
+			family: M.AddressFamilyFqdn, version: 4,
+		},
+	}
+	for _, fixture := range fixtures {
+		t.Run(fixture.name, func(t *testing.T) {
+			clientConn, handler := startHandshake(t, nil)
+			fixture.request(t, clientConn)
+			connection := handler.wait(t)
+			requestMetadata := requestMetadataOf(t, connection.conn)
+			if requestMetadata.Version != fixture.version {
+				t.Fatalf("metadata version = %d, want %d", requestMetadata.Version, fixture.version)
+			}
+			if requestMetadata.DestinationFamily != fixture.family {
+				t.Fatalf("metadata family = %d, want %d", requestMetadata.DestinationFamily, fixture.family)
+			}
+			_ = connection.conn.Close()
+		})
+	}
+}
+
+func readSOCKS5Reply(t *testing.T, conn net.Conn) []byte {
+	t.Helper()
+	header := readN(t, conn, 4)
+	switch header[3] {
+	case 0x01:
+		return append(header, readN(t, conn, 6)...)
+	case 0x04:
+		return append(header, readN(t, conn, 18)...)
+	case 0x03:
+		length := readN(t, conn, 1)
+		return append(append(header, length...), readN(t, conn, int(length[0])+2)...)
+	default:
+		t.Fatalf("unexpected SOCKS5 reply address type: %x", header[3])
+		return nil
+	}
+}
+
+func readPayloadThroughLazyConn(t *testing.T, clientConn net.Conn, conn net.Conn, length int) []byte {
+	t.Helper()
+	received := make([]byte, length)
+	readDone := make(chan error, 1)
+	go func() {
+		_, err := io.ReadFull(conn, received)
+		readDone <- err
+	}()
+	// The success reply is written lazily on the first read.
+	reply := readSOCKS5Reply(t, clientConn)
+	if reply[1] != 0x00 {
+		t.Fatalf("unexpected success reply: %x", reply)
+	}
+	if err := <-readDone; err != nil {
+		t.Fatalf("read transferred payload: %v", err)
+	}
+	return received
+}
+
+func TestHandleConnectionExTransfersBufferedPayloadOnce(t *testing.T) {
+	for _, size := range []int{1, 11, 4095, 4096, 8192} {
+		size := size
+		t.Run(fmt.Sprintf("payload-%d", size), func(t *testing.T) {
+			clientConn, handler := startHandshake(t, nil)
+			payload := make([]byte, size)
+			for index := range payload {
+				payload[index] = byte(index*7 + 3)
+			}
+			negotiateSOCKS5(t, clientConn)
+			go func() {
+				_, _ = clientConn.Write(append(request5ATYP3("example.com", 443), payload...))
+			}()
+			connection := handler.wait(t)
+			received := readPayloadThroughLazyConn(t, clientConn, connection.conn, size)
+			if !bytes.Equal(received, payload) {
+				t.Fatal("transferred payload differs from the written payload")
+			}
+			_ = connection.conn.Close()
+		})
+	}
+}
+
+func TestHandleConnectionExTransfersPayloadForSOCKS4Forms(t *testing.T) {
+	fixtures := []struct {
+		name    string
+		request func() []byte
+	}{
+		{name: "socks4-literal", request: func() []byte {
+			return request4(netip.MustParseAddr("192.0.2.9"), 443)
+		}},
+		{name: "socks4a-hostname", request: func() []byte {
+			return request4a("example.com", 443)
+		}},
+	}
+	for _, fixture := range fixtures {
+		t.Run(fixture.name, func(t *testing.T) {
+			clientConn, handler := startHandshake(t, nil)
+			payload := []byte("early-bytes")
+			go func() {
+				_, _ = clientConn.Write(append(fixture.request(), payload...))
+			}()
+			connection := handler.wait(t)
+			received := make([]byte, len(payload))
+			readDone := make(chan error, 1)
+			go func() {
+				_, err := io.ReadFull(connection.conn, received)
+				readDone <- err
+			}()
+			reply := readN(t, clientConn, 8)
+			if reply[1] != 0x5A {
+				t.Fatalf("unexpected SOCKS4 success reply: %x", reply)
+			}
+			if err := <-readDone; err != nil {
+				t.Fatalf("read transferred payload: %v", err)
+			}
+			if !bytes.Equal(received, payload) {
+				t.Fatalf("payload = %q, want %q", received, payload)
+			}
+			_ = connection.conn.Close()
+		})
+	}
+}
+
+func TestHandleConnectionExDoesNotReadAhead(t *testing.T) {
+	clientConn, handler := startHandshake(t, nil)
+	negotiateSOCKS5(t, clientConn)
+	writeAll(t, clientConn, request5ATYP1(netip.MustParseAddr("203.0.113.9"), 443))
+	connection := handler.wait(t)
+	readErr := make(chan error, 1)
+	go func() {
+		buffer := make([]byte, 1)
+		_, err := connection.conn.Read(buffer)
+		readErr <- err
+	}()
+	if reply := readSOCKS5Reply(t, clientConn); reply[1] != 0x00 {
+		t.Fatalf("unexpected success reply: %x", reply)
+	}
+	select {
+	case err := <-readErr:
+		t.Fatalf("handshake read returned without client payload: %v", err)
+	case <-time.After(150 * time.Millisecond):
+	}
+	_ = connection.conn.Close()
+}
+
+func TestHandleConnectionExAuthFailureDispatchesNothing(t *testing.T) {
+	authenticator := auth.NewAuthenticator([]auth.User{{Username: "user", Password: "pass"}})
+	clientConn, handler := startHandshake(t, authenticator)
+	writeAll(t, clientConn, []byte{0x05, 0x01, 0x02})
+	if reply := readN(t, clientConn, 2); !bytes.Equal(reply, []byte{0x05, 0x02}) {
+		t.Fatalf("unexpected method selection: %x", reply)
+	}
+	writeAll(t, clientConn, []byte{0x01, 0x04, 'u', 's', 'e', 'r', 0x03, 'b', 'a', 'd'})
+	if reply := readN(t, clientConn, 2); !bytes.Equal(reply, []byte{0x01, 0x01}) {
+		t.Fatalf("unexpected authentication status: %x", reply)
+	}
+	handler.expectNoConnection(t)
+}
+
+func TestHandleConnectionExFailureBeforeSuccessIsTerminal(t *testing.T) {
+	clientConn, handler := startHandshake(t, nil)
+	negotiateSOCKS5(t, clientConn)
+	writeAll(t, clientConn, request5ATYP1(netip.MustParseAddr("203.0.113.9"), 443))
+	connection := handler.wait(t)
+	lazyConn := connection.conn.(*LazyConn)
+	failureDone := make(chan error, 1)
+	go func() {
+		failureDone <- lazyConn.HandshakeFailure(syscall.EPERM)
+	}()
+	reply := readN(t, clientConn, 10)
+	if reply[1] != 0x02 {
+		t.Fatalf("failure reply code = %d, want 2", reply[1])
+	}
+	if err := <-failureDone; err != nil {
+		t.Fatalf("write failure reply: %v", err)
+	}
+	if err := lazyConn.ConnHandshakeSuccess(lazyConn); err != nil {
+		t.Fatalf("late success must be a no-op: %v", err)
+	}
+	if err := clientConn.SetReadDeadline(time.Now().Add(100 * time.Millisecond)); err != nil {
+		t.Fatalf("set read deadline: %v", err)
+	}
+	extra := make([]byte, 1)
+	if _, err := clientConn.Read(extra); err == nil {
+		t.Fatal("a second SOCKS5 reply was written after the terminal failure")
+	}
+	_ = connection.conn.Close()
+}
+
+func TestHandleConnectionExDenialDoesNotDeliverBufferedPayload(t *testing.T) {
+	clientConn, handler := startHandshake(t, nil)
+	negotiateSOCKS5(t, clientConn)
+	payload := []byte("must-not-be-forwarded")
+	writeAll(t, clientConn, append(request5ATYP3("example.com", 443), payload...))
+	connection := handler.wait(t)
+	lazyConn := connection.conn.(*LazyConn)
+	failureDone := make(chan error, 1)
+	go func() {
+		failureDone <- lazyConn.HandshakeFailure(syscall.EPERM)
+	}()
+	if reply := readN(t, clientConn, 10); reply[1] != 0x02 {
+		t.Fatalf("denial reply code = %d, want 2", reply[1])
+	}
+	if err := <-failureDone; err != nil {
+		t.Fatalf("write denial: %v", err)
+	}
+	if err := connection.conn.Close(); err != nil && !errors.Is(err, os.ErrClosed) {
+		t.Fatalf("close denied connection: %v", err)
+	}
+}
