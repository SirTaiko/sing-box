@@ -0,0 +1,78 @@
+package socks
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+var _ RequestMetadataProvider = (*LazyConn)(nil)
+
+func TestNewLazyConnHasNoRequestMetadata(t *testing.T) {
+	clientConn, serverConn := net.Pipe()
+	defer clientConn.Close()
+	defer serverConn.Close()
+	lazyConn := NewLazyConn(serverConn, 5)
+	if _, known := lazyConn.RequestMetadata(); known {
+		t.Fatal("NewLazyConn reported request provenance it never observed")
+	}
+}
+
+func TestLazyConnRequestMetadataIsAnImmutableValue(t *testing.T) {
+	clientConn, serverConn := net.Pipe()
+	defer clientConn.Close()
+	defer serverConn.Close()
+	lazyConn := newLazyConnWithRequestMetadata(serverConn, 4, RequestMetadata{
+		Version:           4,
+		DestinationFamily: M.AddressFamilyFqdn,
+	})
+	requestMetadata, known := lazyConn.RequestMetadata()
+	if !known {
+		t.Fatal("constructed request metadata was not reported")
+	}
+	if requestMetadata.Version != 4 || requestMetadata.DestinationFamily != M.AddressFamilyFqdn {
+		t.Fatalf("unexpected request metadata: %+v", requestMetadata)
+	}
+	requestMetadata.DestinationFamily = M.AddressFamilyIPv4
+	again, known := lazyConn.RequestMetadata()
+	if !known {
+		t.Fatal("request metadata disappeared")
+	}
+	if again.DestinationFamily != M.AddressFamilyFqdn {
+		t.Fatalf("caller mutation changed stored provenance: %+v", again)
+	}
+	replyDone := make(chan error, 1)
+	go func() {
+		replyDone <- lazyConn.ConnHandshakeSuccess(lazyConn)
+	}()
+	reply := make([]byte, 4)
+	if _, err := io.ReadFull(clientConn, reply); err != nil {
+		t.Fatalf("read success reply: %v", err)
+	}
+	if reply[1] != 0x5A {
+		t.Fatalf("unexpected SOCKS4 reply: %x", reply)
+	}
+	if err := <-replyDone; err != nil {
+		t.Fatalf("write success reply: %v", err)
+	}
+	afterReply, known := lazyConn.RequestMetadata()
+	if !known || afterReply != again {
+		t.Fatalf("provenance changed after the handshake reply: %+v", afterReply)
+	}
+}
+
+func TestLazyConnRequestMetadataSurvivesContextUse(t *testing.T) {
+	// The capability is per connection state, not context global state.
+	connectionA := newLazyConnWithRequestMetadata(nil, 5, RequestMetadata{Version: 5, DestinationFamily: M.AddressFamilyIPv4})
+	connectionB := newLazyConnWithRequestMetadata(nil, 5, RequestMetadata{Version: 5, DestinationFamily: M.AddressFamilyFqdn})
