@@ -0,0 +1,232 @@
+package socks
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	singBufio "github.com/sagernet/sing/common/bufio"
+)
+
+// These tests pin the ownership of the early payload that the shared handshake
+// transfers into the returned connection. The success reply is always completed
+// before the returned connection is used concurrently, so a failure here is a
+// cached-tail ownership defect and not the older lazy-reply race.
+
+func openEarlyTailConnection(t *testing.T, tail []byte) net.Conn {
+	t.Helper()
+	clientConn, handler := startHandshake(t, nil)
+	negotiateSOCKS5(t, clientConn)
+	writeAll(t, clientConn, append(request5ATYP1(netip.MustParseAddr("203.0.113.9"), 443), tail...))
+	connection := handler.wait(t)
+	conn := connection.conn
+	replyRead := make(chan error, 1)
+	go func() {
+		_, err := io.ReadFull(clientConn, make([]byte, 10))
+		replyRead <- err
+	}()
+	if err := conn.(*LazyConn).ConnHandshakeSuccess(conn); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-replyRead; err != nil {
+		t.Fatal(err)
+	}
+	return conn
+}
+
+func earlyTail(size int) []byte {
+	tail := make([]byte, size)
+	for index := range tail {
+		tail[index] = byte(index*7 + 3)
+	}
+	return tail
+}
+
+func TestHandshakeEarlyTailDeliveredExactlyOnce(t *testing.T) {
+	tail := earlyTail(2048)
+	conn := openEarlyTailConnection(t, tail)
+	received := make([]byte, len(tail))
+	if _, err := io.ReadFull(conn, received); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(received, tail) {
+		t.Fatal("early payload changed")
+	}
+	if !conn.(*LazyConn).ReaderReplaceable() {
+		t.Fatal("consumed early payload still reported as unreplaced")
+	}
+	// Reading again must reach the empty pipe: no duplicated early payload.
+	if err := conn.SetReadDeadline(time.Now().Add(50 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := conn.Read(make([]byte, 1)); n != 0 || err == nil {
+		t.Fatalf("read after early payload: n=%d err=%v", n, err)
+	}
+	if err := conn.SetReadDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestHandshakeEarlyTailConcurrentReadClose(t *testing.T) {
+	tail := earlyTail(2048)
+	for iteration := 0; iteration < 32; iteration++ {
+		conn := openEarlyTailConnection(t, tail)
+		start := make(chan struct{})
+		var group sync.WaitGroup
+		group.Add(2)
+		received := make([]byte, 0, len(tail))
+		panics := make(chan any, 1)
+		go func() {
+			defer group.Done()
+			defer func() {
+				if recovered := recover(); recovered != nil {
+					panics <- recovered
+				}
+			}()
+			<-start
+			one := make([]byte, 1)
+			for {
+				n, err := conn.Read(one)
+				if n > 0 {
+					received = append(received, one[0])
+				}
+				if err != nil {
+					return
+				}
+			}
+		}()
+		closeDone := make(chan error, 1)
+		go func() {
+			defer group.Done()
+			<-start
+			closeDone <- conn.Close()
+		}()
+		close(start)
+		group.Wait()
+		select {
+		case recovered := <-panics:
+			t.Fatalf("returned handshake connection panicked during concurrent read/close: %v", recovered)
+		default:
+		}
+		if err := <-closeDone; err != nil {
+			t.Fatal(err)
+		}
+		if len(received) > len(tail) {
+			t.Fatalf("read %d bytes from a %d byte early payload", len(received), len(tail))
+		}
+		if !bytes.Equal(received, tail[:len(received)]) {
+			t.Fatal("early payload changed during concurrent read/close")
+		}
+	}
+}
+
+type tallyWriter struct {
+	received []byte
+}
+
+func (w *tallyWriter) Write(p []byte) (int, error) {
+	w.received = append(w.received, p...)
+	return len(p), nil
+}
+
+func TestHandshakeEarlyTailConcurrentCopyClose(t *testing.T) {
+	tail := earlyTail(2048)
+	for iteration := 0; iteration < 32; iteration++ {
+		conn := openEarlyTailConnection(t, tail)
+		start := make(chan struct{})
+		var group sync.WaitGroup
+		group.Add(2)
+		destination := &tallyWriter{}
+		copyDone := make(chan struct{})
+		go func() {
+			defer group.Done()
+			defer close(copyDone)
+			<-start
+			_, _ = singBufio.CopyWithIncreateBuffer(destination, conn, 512*1000, 8)
+		}()
+		go func() {
+			defer group.Done()
+			<-start
+			_ = conn.Close()
+		}()
+		close(start)
+		group.Wait()
+		select {
+		case <-copyDone:
+		case <-time.After(30 * time.Second):
+			t.Fatal("copy did not finish after close")
+		}
+		if len(destination.received) > len(tail) {
+			t.Fatalf("copied %d bytes from a %d byte early payload", len(destination.received), len(tail))
+		}
+		if !bytes.Equal(destination.received, tail[:len(destination.received)]) {
+			t.Fatal("early payload changed during concurrent copy/close")
+		}
+	}
+}
+
+func TestHandshakeNoTailConcurrentReadClose(t *testing.T) {
+	for iteration := 0; iteration < 32; iteration++ {
+		conn := openEarlyTailConnection(t, nil)
+		start := make(chan struct{})
+		var group sync.WaitGroup
+		group.Add(2)
+		readDone := make(chan error, 1)
+		go func() {
+			defer group.Done()
+			<-start
+			_, err := conn.Read(make([]byte, 1))
+			readDone <- err
+		}()
+		go func() {
+			defer group.Done()
+			<-start
+			_ = conn.Close()
+		}()
+		close(start)
+		group.Wait()
+		if err := <-readDone; err == nil {
+			t.Fatal("expected a cancelled read error after close")
+		}
+	}
+}
+
+func TestHandshakeEarlyTailBlockedReadCancelledByClose(t *testing.T) {
+	tail := earlyTail(2048)
+	conn := openEarlyTailConnection(t, tail)
+	if _, err := io.ReadFull(conn, tail); err != nil {
+		t.Fatal(err)
+	}
+	readDone := make(chan error, 1)
+	go func() {
+		_, err := conn.Read(make([]byte, 1))
+		readDone <- err
+	}()
+	select {
+	case err := <-readDone:
+		t.Fatalf("read returned before close: %v", err)
+	case <-time.After(100 * time.Millisecond):
+	}
+	closeDone := make(chan error, 1)
+	go func() {
+		closeDone <- conn.Close()
+	}()
+	select {
+	case err := <-readDone:
+		if err == nil {
+			t.Fatal("expected a cancelled read error after close")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("close did not unblock the underlying read")
+	}
+	if err := <-closeDone; err != nil {
+		t.Fatal(err)
+	}
+}
