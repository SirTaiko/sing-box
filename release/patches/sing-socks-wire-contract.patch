diff --git a/common/bufio/cache_conn_test.go b/common/bufio/cache_conn_test.go
new file mode 100644
index 0000000..809252d
--- /dev/null
+++ b/common/bufio/cache_conn_test.go
@@ -0,0 +1,240 @@
+package bufio
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/buf"
+)
+
+// These tests pin the ownership contract of the cached tail installed by
+// NewCachedConn: the buffered bytes are delivered exactly once, every release
+// path releases the pooled buffer exactly once, and concurrent Read,
+// ReadCached, WriteTo, ReaderReplaceable and Close are safe.
+
+func newCachedTailConn(t *testing.T, tail []byte) (*CachedConn, net.Conn) {
+	t.Helper()
+	buffer := buf.NewSize(len(tail))
+	if _, err := buffer.WriteString(string(tail)); err != nil {
+		t.Fatal(err)
+	}
+	upstream, peer := net.Pipe()
+	conn := NewCachedConn(upstream, buffer)
+	t.Cleanup(func() {
+		_ = conn.Close()
+		_ = peer.Close()
+	})
+	return conn, peer
+}
+
+func testTail(size int) []byte {
+	tail := make([]byte, size)
+	for index := range tail {
+		tail[index] = byte(index*7 + 3)
+	}
+	return tail
+}
+
+func TestCachedTailDeliveredExactlyOnce(t *testing.T) {
+	tail := testTail(2048)
+	conn, _ := newCachedTailConn(t, tail)
+	received := make([]byte, len(tail))
+	if _, err := io.ReadFull(conn, received); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(received, tail) {
+		t.Fatal("cached tail changed")
+	}
+	if !conn.ReaderReplaceable() {
+		t.Fatal("consumed cached tail still reported as unreplaced")
+	}
+	// The consumed tail must not be delivered twice: the next read reaches the
+	// empty upstream pipe and blocks.
+	if err := conn.SetReadDeadline(time.Now().Add(50 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := conn.Read(make([]byte, 1)); n != 0 || err == nil {
+		t.Fatalf("read after cached tail: n=%d err=%v", n, err)
+	}
+	if err := conn.SetReadDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCachedTailReadCachedTakenOnce(t *testing.T) {
+	tail := testTail(11)
+	conn, _ := newCachedTailConn(t, tail)
+	taken := conn.ReadCached()
+	if taken == nil {
+		t.Fatal("cached tail was not returned")
+	}
+	if !bytes.Equal(taken.Bytes(), tail) {
+		t.Fatal("taken cached tail changed")
+	}
+	taken.Release()
+	if again := conn.ReadCached(); again != nil {
+		t.Fatal("cached tail was claimed twice")
+	}
+	if !conn.ReaderReplaceable() {
+		t.Fatal("connection with a consumed tail is not replaceable")
+	}
+}
+
+func TestCachedTailWriteToDeliveredOnce(t *testing.T) {
+	tail := testTail(4096)
+	conn, peer := newCachedTailConn(t, tail)
+	go func() {
+		time.Sleep(50 * time.Millisecond)
+		_ = peer.Close()
+	}()
+	var destination bytes.Buffer
+	n, _ := conn.WriteTo(&destination)
+	if n != int64(len(tail)) {
+		t.Fatalf("WriteTo delivered %d cached bytes, want %d", n, len(tail))
+	}
+	if !bytes.Equal(destination.Bytes(), tail) {
+		t.Fatal("WriteTo delivered changed cached bytes")
+	}
+	var second bytes.Buffer
+	n, _ = conn.WriteTo(&second)
+	if n != 0 || second.Len() != 0 {
+		t.Fatalf("cached tail delivered twice: %d bytes", n)
+	}
+}
+
+func TestCachedTailConcurrentReadClose(t *testing.T) {
+	tail := testTail(2048)
+	for iteration := 0; iteration < 32; iteration++ {
+		conn, _ := newCachedTailConn(t, tail)
+		start := make(chan struct{})
+		var group sync.WaitGroup
+		group.Add(2)
+		received := make([]byte, 0, len(tail))
+		go func() {
+			defer group.Done()
+			<-start
+			one := make([]byte, 1)
+			for {
+				n, err := conn.Read(one)
+				if n > 0 {
+					received = append(received, one[0])
+				}
+				if err != nil {
+					return
+				}
+			}
+		}()
+		go func() {
+			defer group.Done()
+			<-start
+			_ = conn.Close()
+		}()
+		close(start)
+		group.Wait()
+		if len(received) > len(tail) {
+			t.Fatalf("read %d bytes from a %d byte cached tail", len(received), len(tail))
+		}
+		if !bytes.Equal(received, tail[:len(received)]) {
+			t.Fatal("cached tail bytes changed during concurrent read/close")
+		}
+	}
+}
+
+func TestCachedTailConcurrentReaderReplaceableClose(t *testing.T) {
+	tail := testTail(2048)
+	for iteration := 0; iteration < 64; iteration++ {
+		conn, _ := newCachedTailConn(t, tail)
+		start := make(chan struct{})
+		var group sync.WaitGroup
+		group.Add(2)
+		var replaceable bool
+		go func() {
+			defer group.Done()
+			<-start
+			replaceable = conn.ReaderReplaceable()
+		}()
+		go func() {
+			defer group.Done()
+			<-start
+			_ = conn.Close()
+		}()
+		close(start)
+		group.Wait()
+		if replaceable {
+			if n, err := conn.Read(make([]byte, 1)); n != 0 || err == nil {
+				t.Fatalf("replaceable connection still holds cached bytes: n=%d err=%v", n, err)
+			}
+		}
+		if !conn.ReaderReplaceable() {
+			t.Fatal("closed connection still reports an unreplaced tail")
+		}
+	}
+}
+
+func TestCachedTailConcurrentReadCachedClose(t *testing.T) {
+	tail := testTail(4096)
+	for iteration := 0; iteration < 64; iteration++ {
+		conn, _ := newCachedTailConn(t, tail)
+		start := make(chan struct{})
+		var group sync.WaitGroup
+		group.Add(2)
+		var taken *buf.Buffer
+		go func() {
+			defer group.Done()
+			<-start
+			taken = conn.ReadCached()
+		}()
+		go func() {
+			defer group.Done()
+			<-start
+			_ = conn.Close()
+		}()
+		close(start)
+		group.Wait()
+		if taken != nil {
+			if !bytes.Equal(taken.Bytes(), tail) {
+				t.Fatal("taken cached tail changed during concurrent close")
+			}
+			taken.Release()
+		}
+	}
+}
+
+func TestCachedTailCloseUnblocksUpstreamRead(t *testing.T) {
+	tail := testTail(2048)
+	conn, _ := newCachedTailConn(t, tail)
+	if _, err := io.ReadFull(conn, tail); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, err := conn.Read(make([]byte, 1))
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		t.Fatalf("read returned before close: %v", err)
+	case <-time.After(100 * time.Millisecond):
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("expected a cancelled read error after close")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("close did not unblock the underlying read")
+	}
+}
